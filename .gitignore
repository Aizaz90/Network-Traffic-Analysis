.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
*ssl-key*
*keylog*
*secrets*

# Local temp and editor files
*.tmp
*.swp
*.swo
.DS_Store
__pycache__/
.venv/
